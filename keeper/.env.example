# Starknet RPC endpoint
RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/gpR0c9Le2dR45Fqit9OXTz6dtpf1HPfa

# Keeper wallet — needs STRK for gas only, zero capital required
KEEPER_ADDRESS=0x...
KEEPER_PRIVATE_KEY=0x...

# Deployed PrivateSwap contract address
CONTRACT_ADDRESS=0x399564e68281724433b3ae82b10632b4f5398c7f0c41b6a0c2e1c59d14189c2

# GraphQL endpoint exposed by the indexer
GRAPHQL_URL=http://localhost:5100/graphql

# How often to check for due orders (milliseconds). Default: 5 minutes.
POLL_INTERVAL_MS=300000

# Maximum number of execute_dca calls to batch in a single transaction.
# Lower this if you hit gas limits. Default: 20.
MAX_BATCH_SIZE=20
